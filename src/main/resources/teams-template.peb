{% set statusText = firstFailed == false ? "Succeeded" : ("Failed on task `" ~ firstFailed.taskId ~ "`") %}
{% set summaryText = "*<" ~ link ~ "|[" ~ execution.namespace ~ "] " ~ execution.flowId ~ " ➛ " ~ execution.state.current ~ ">*
> " ~ statusText ~ " after " ~ duration %}
{
    "@type": "MessageCard",
    "@context": "http://schema.org/extensions",
    "themeColor": {{ themeColor | toJson }},
    "summary": {{ summaryText | toJson }},
    "sections": [{
        {% if activityTitle is defined %}
        "activityTitle": {{ activityTitle | toJson }},
        {% endif %}
        {% if activitySubtitle is defined %}
        "activitySubtitle": {{ activitySubtitle | toJson }},
        {% endif %}
        "facts": [{
            "name": "Namespace",
            "value": {{ execution.namespace | toJson }}
        }, {
            "name": "Flow ID",
            "value": {{ execution.flowId | toJson }}
        }, {
            "name": "Execution ID",
            "value": {{ execution.id | toJson }}
        }, {
            "name": "Execution Status",
            "value": {{ execution.state.current | toJson }}
        }, {
            "name": "Final task ID",
            "value": {{ lastTask.taskId | toJson }}
        }{% if customMessage is defined %}, {
            "name": "Message",
            "value": {{ customMessage | toJson }}
        }{% endif %}{% if customFields is defined and customFields is not empty %}, {% for entry in customFields %}{
            "name": {{ entry.key | toJson }},
            "value": {{ entry.value | toJson }}
        }{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}],
        "markdown": true
    }]
}