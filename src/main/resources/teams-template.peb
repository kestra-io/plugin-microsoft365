{# executionMap() omits firstFailed and lastTask when no task run matches the state filter (core 1.3.x), and sets lastTask to null on newer cores #}
{% set failed = firstFailed is defined and firstFailed != false %}
{% set lastTaskId = (lastTask is defined and lastTask is not null) ? lastTask.taskId : "" %}
{% set statusText = failed ? ("Failed on task `" ~ firstFailed.taskId ~ "`") : "Succeeded" %}
{# Pebble string literals don't unescape \n, so decode a JSON string to get a real newline #}
{% set nl = fromJson('"\n"') %}
{% set summaryText = "*<" ~ link ~ "|[" ~ execution.namespace ~ "] " ~ execution.flowId ~ " ➛ " ~ execution.state.current ~ ">*" ~ nl ~ "> " ~ statusText ~ " after " ~ duration %}
{
    "@type": "MessageCard",
    "@context": "http://schema.org/extensions",
    "themeColor": {{ themeColor | toJson }},
    "summary": {{ summaryText | toJson }},
    "sections": [{
        {% if activityTitle is defined %}
        "activityTitle": {{ activityTitle | toJson }},
        {% endif %}
        {% if activitySubtitle is defined %}
        "activitySubtitle": {{ activitySubtitle | toJson }},
        {% endif %}
        "facts": [{
            "name": "Namespace",
            "value": {{ execution.namespace | toJson }}
        }, {
            "name": "Flow ID",
            "value": {{ execution.flowId | toJson }}
        }, {
            "name": "Execution ID",
            "value": {{ execution.id | toJson }}
        }, {
            "name": "Execution Status",
            "value": {{ execution.state.current | toJson }}
        }, {
            "name": "Final task ID",
            "value": {{ lastTaskId | toJson }}
        }{% if customMessage is defined %}, {
            "name": "Message",
            "value": {{ customMessage | toJson }}
        }{% endif %}{% if customFields is defined and customFields is not empty %}, {% for entry in customFields %}{
            "name": {{ entry.key | toJson }},
            "value": {{ ((entry.value is map or entry.value is iterable) ? (entry.value | toJson) : (entry.value | string | default(""))) | toJson }}
        }{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}],
        "markdown": true
    }]
}